<?xml version="1.0" encoding="utf-8"?>
<!-- Practice screen of any topic set (PracticeActivity): no camera, no recording. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/practice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/practice_title"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/practice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/practice_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_plan_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#64B5F6"
                android:textDirection="firstStrong"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/practice_why"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#B3FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="13sp" />

            <!-- The stage: the topic as it will look in the recording. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#000000"
                android:minHeight="200dp">

                <TextView
                    android:id="@+id/practice_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/bitter"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="24dp"
                    android:textColor="#FFFFFF"
                    android:textDirection="firstStrong"
                    android:textSize="26sp" />

                <ImageView
                    android:id="@+id/practice_stage_image"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/practice_stage_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_plan_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#64B5F6"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/practice_say_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/practice_say_label"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <!-- What the user plans to say on this topic: prefilled with the plan's line or their saved note,
                 editable, saved to the topic. -->
            <EditText
                android:id="@+id/practice_say"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_practice_note"
                android:gravity="top|start"
                android:hint="@string/practice_say_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.3"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="18sp" />

            <!-- The closing line (last step only), read-only. -->
            <TextView
                android:id="@+id/practice_closing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textIsSelectable="true"
                android:textSize="18sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/practice_prev"
                    style="@style/Widget.App.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:minHeight="40dp"
                    android:minWidth="112dp"
                    android:text="@string/cplan_previous"
                    android:textColor="#0B1620"
                    android:textSize="15sp"
                    app:backgroundTint="#64B5F6"
                    app:cornerRadius="20dp" />

                <TextView
                    android:id="@+id/practice_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/practice_next"
                    style="@style/Widget.App.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:minHeight="40dp"
                    android:minWidth="112dp"
                    android:text="@string/cplan_next_beat"
                    android:textColor="#0B1620"
                    android:textSize="15sp"
                    app:backgroundTint="#64B5F6"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <Button
                android:id="@+id/practice_toggle_script"
                style="@style/Widget.App.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:minHeight="40dp"
                android:text="@string/cplan_show_script"
                android:textColor="#64B5F6"
                android:textSize="15sp"
                app:cornerRadius="20dp"
                app:strokeColor="#64B5F6"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:id="@+id/practice_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/practice_use"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginEnd="12dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:minHeight="40dp"
            android:visibility="gone"
            android:text="@string/cplan_use_topics"
            android:textColor="#0B1620"
            android:textSize="15sp"
            app:backgroundTint="#64B5F6"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/practice_done"
            style="@style/Widget.App.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:minHeight="40dp"
            android:text="@string/cplan_done"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="20dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
