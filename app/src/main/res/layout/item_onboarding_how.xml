<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2: How does it do? One idea per row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OnbPage">

    <TextView
        style="@style/OnbTitle"
        android:text="@string/onb_title_how" />

    <ScrollView style="@style/OnbScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    style="@style/OnbRowIcon"
                    android:src="@drawable/ic_share" />

                <TextView
                    android:id="@+id/onb_how_publish"
                    style="@style/OnbBody"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- The whole effort: click Start, talk, click Stop. Then a brushed divider. -->
            <TextView
                android:id="@+id/onb_how_offer"
                style="@style/OnbOffer"
                android:layout_marginTop="28dp" />

            <com.jovoc.facecampresentationrecorder.ui.BrushDividerView
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <ImageView
                    style="@style/OnbRowIcon"
                    android:src="@drawable/ic_ai_sparkle" />

                <TextView
                    style="@style/OnbBody"
                    android:layout_marginStart="14dp"
                    android:text="@string/onb_how_ai" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <ImageView
                    style="@style/OnbRowIcon"
                    android:src="@drawable/ic_edit" />

                <TextView
                    style="@style/OnbBody"
                    android:layout_marginStart="14dp"
                    android:text="@string/onb_how_edit" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
