<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3: What do you have to do? Ends with the founder's note, then three buttons: strategy, watch, start recording. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/OnbPage">

    <TextView
        style="@style/OnbTitle"
        android:text="@string/onb_title_todo" />

    <ScrollView style="@style/OnbScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/onb_todo_talk"
                style="@style/OnbBody" />

            <TextView
                android:id="@+id/onb_todo_grow"
                style="@style/OnbBody"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/bitter"
                android:text="@string/onb_todo_doubt"
                android:textColor="@color/onb_title"
                android:textSize="20sp"
                android:textStyle="italic" />

            <!-- The founder's note: his face beside the first line, then plain text. No card, no link. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/onb_founder_photo_desc"
                    android:scaleType="centerCrop"
                    android:src="@drawable/founder_photo"
                    app:shapeAppearanceOverlay="@style/OnbCircle" />

                <TextView
                    style="@style/OnbBody"
                    android:layout_width="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/onb_note_personal" />
            </LinearLayout>

            <TextView
                style="@style/OnbBody"
                android:layout_marginTop="12dp"
                android:text="@string/onb_note_intro" />

            <TextView
                style="@style/OnbBody"
                android:layout_marginTop="12dp"
                android:text="@string/onb_note_brands" />

            <TextView
                style="@style/OnbBody"
                android:layout_marginTop="12dp"
                android:text="@string/onb_note_secrets" />
        </LinearLayout>
    </ScrollView>

    <!-- 1 of 3: the filled "Start recording video" is the shared button below the pager. -->
    <Button
        android:id="@+id/btn_onb_strategy"
        style="@style/OnbOutlinedButton"
        android:text="@string/onb_brand_strategy" />

    <!-- 2 of 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onb_watch"
        style="@style/OnbOutlinedButton"
        android:layout_marginBottom="12dp"
        android:text="@string/onb_watch_how"
        app:icon="@drawable/ic_youtube"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="24dp"
        app:iconTint="@color/onb_accent" />
</LinearLayout>
