<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3: What do I have to do? Ends with the founder card and the story button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/OnbPage">

    <TextView
        style="@style/OnbTitle"
        android:text="@string/onb_title_todo" />

    <ScrollView style="@style/OnbScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/onb_todo_talk"
                style="@style/OnbBody" />

            <TextView
                android:id="@+id/onb_todo_grow"
                style="@style/OnbBody"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/bitter"
                android:text="@string/onb_todo_doubt"
                android:textColor="@color/onb_title"
                android:textSize="20sp"
                android:textStyle="italic" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_onb_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="#161B2E"
                        android:contentDescription="@string/onb_founder_photo_desc"
                        android:scaleType="centerCrop"
                        android:src="@drawable/founder_photo"
                        app:shapeAppearanceOverlay="@style/OnbCircle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onb_founder_name"
                            android:textColor="@color/onb_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/onb_founder_role"
                            android:textColor="@color/onb_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/OnbBody"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_founder_promise" />

                <!-- Opens in the browser; onboarding stays open behind it. -->
                <LinearLayout
                    android:id="@+id/onb_founder_github"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_web"
                        app:tint="@color/onb_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/onb_founder_github"
                        android:textColor="@color/onb_accent"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_onb_strategy"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:text="@string/onb_brand_strategy"
        android:textAllCaps="false"
        android:textColor="@color/onb_accent"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:rippleColor="@color/onb_progress_track"
        app:strokeColor="@color/onb_accent"
        app:strokeWidth="1.5dp" />
</LinearLayout>
