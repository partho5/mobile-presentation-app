<?xml version="1.0" encoding="utf-8"?>
<!-- Today's video: the content-plan card shown under the top menu bar (ContentPlanCard). Never shown while recording. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_content_plan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@id/top_menu_bar"
    android:layout_margin="12dp"
    android:elevation="8dp"
    android:visibility="gone"
    app:cardBackgroundColor="#222222"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeColor="#00000000"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/cplan_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textDirection="firstStrong"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cplan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textDirection="firstStrong"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cplan_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_plan_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#64B5F6"
            android:textDirection="firstStrong"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cplan_why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3FFFFFF"
            android:textDirection="firstStrong"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/cplan_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cplan_btn_use"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cplan_use_topics"
                android:textColor="#64B5F6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cplan_btn_practice"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cplan_practice"
                android:textColor="#64B5F6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cplan_btn_week"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cplan_week"
                android:textColor="#64B5F6"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/cplan_btn_setup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cplan_setup_open"
            android:textColor="#64B5F6"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cplan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64B5F6"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
