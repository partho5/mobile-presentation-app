<?xml version="1.0" encoding="utf-8"?>
<!-- Today's video: the slim content-plan strip shown under the top menu bar (ContentPlanCard). Never shown while recording. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_content_plan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@id/top_menu_bar"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:elevation="8dp"
    android:visibility="gone"
    app:cardBackgroundColor="#CC1E1E1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cplan_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cplan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/cplan_btn_practice"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:insetTop="4dp"
            android:insetBottom="4dp"
            android:minHeight="40dp"
            android:text="@string/cplan_practice"
            android:textColor="#0B1620"
            android:textSize="14sp"
            app:backgroundTint="#64B5F6"
            app:cornerRadius="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
