<?xml version="1.0" encoding="utf-8"?>
<!-- The email -> 6-digit code form, shared by the full sign-in screen (activity_sign_in) and the in-place
     sign-in sheet (sheet_sign_in). SignInPanel drives it by these ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sign_in_form"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_sign_in_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sign_in_email_hint_text"
        android:textColor="#AAAAAA"
        android:textSize="15sp" />

    <!-- Step 1: email -->
    <LinearLayout
        android:id="@+id/step_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:autofillHints="emailAddress"
            android:background="#2B2B2B"
            android:hint="@string/sign_in_email_field"
            android:imeOptions="actionSend"
            android:importantForAutofill="yes"
            android:inputType="textEmailAddress|textNoSuggestions"
            android:maxLength="254"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_send_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#64B5F6"
            android:text="@string/sign_in_send_code"
            android:textColor="#000000"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_not_now"
            style="@style/Widget.App.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/sign_in_not_now"
            android:textColor="#E0E0E0" />
    </LinearLayout>

    <!-- Step 2: code -->
    <LinearLayout
        android:id="@+id/step_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/edit_code"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:autofillHints="smsOTPCode"
            android:background="#2B2B2B"
            android:gravity="center"
            android:hint="@string/sign_in_code_field"
            android:imeOptions="actionDone"
            android:importantForAutofill="yes"
            android:contentDescription="@string/sign_in_code_desc"
            android:inputType="number"
            android:letterSpacing="0.35"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A8A8A"
            android:textSize="28sp" />

        <Button
            android:id="@+id/btn_verify"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#64B5F6"
            android:text="@string/sign_in_verify"
            android:textColor="#000000"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_resend"
            style="@style/Widget.App.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/sign_in_resend"
            android:textColor="#64B5F6" />

        <Button
            android:id="@+id/btn_change_email"
            style="@style/Widget.App.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sign_in_change_email"
            android:textColor="#E0E0E0" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sign_in_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="#FF6E6E"
        android:textSize="14sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_sign_in"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/sign_in_working"
        android:visibility="gone" />
</LinearLayout>
