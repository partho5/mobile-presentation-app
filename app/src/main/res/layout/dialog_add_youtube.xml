<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded_red"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_youtube_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add YouTube Video Slide"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Paste YouTube link or Video ID"
        android:textColor="#FFCDD2"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edit_youtube_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_white_border_red"
        android:hint="https://www.youtube.com/watch?v=..."
        android:textColorHint="#EF9A9A"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="#D32F2F"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_youtube"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#FFCDD2" />

        <Button
            android:id="@+id/btn_save_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF5252"
            android:text="Save"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
