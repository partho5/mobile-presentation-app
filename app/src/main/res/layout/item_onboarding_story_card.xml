<?xml version="1.0" encoding="utf-8"?>
<!-- A numbered point in the story: round badge + text, drawn on a soft card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_onb_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/onb_card_number"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_onb_badge"
        android:gravity="center"
        android:textColor="@color/onb_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.jovoc.facecampresentationrecorder.ui.MarkerTextView
        android:id="@+id/onb_card_text"
        style="@style/OnbBody"
        android:layout_width="0dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1" />
</LinearLayout>
