<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content Area -->
    <RelativeLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <!-- Container for Image Slide (anchored to top) -->
        <ImageView
            android:id="@+id/image_slide_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:adjustViewBounds="true"
            android:contentDescription="Slide Image"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <!-- Container for Text Slide (Top 30% of screen height) -->
        <FrameLayout
            android:id="@+id/text_slide_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_slide_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/bitter"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:paddingHorizontal="24dp"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </FrameLayout>

        <!-- Container for Video Slide (anchored to top) -->
        <FrameLayout
            android:id="@+id/video_slide_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:visibility="gone">

            <VideoView
                android:id="@+id/video_slide_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal" />
        </FrameLayout>

        <!-- Container for Web / Website & YouTube Slide (1:1 Aspect Ratio) -->
        <FrameLayout
            android:id="@+id/web_slide_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:visibility="gone">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_web_slide"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/web_slide_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Reload Button overlay for Web slide -->
            <ImageButton
                android:id="@+id/btn_reload_web_slide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:alpha="0.75"
                android:background="@drawable/bg_circle_nav"
                android:contentDescription="Reload Web Page"
                android:elevation="10dp"
                android:padding="6dp"
                android:src="@drawable/ic_refresh"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Empty State View when database has 0 slides -->
        <TextView
            android:id="@+id/empty_state_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="32dp"
            android:text="Double-tap to open Menu &amp; Add Slides"
            android:textColor="#66FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Top Action Menu Bar (revealed in Edit Mode / Menu toggle) -->
        <LinearLayout
            android:id="@+id/top_menu_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#DD111111"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_open_drawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Navigation Menu"
                android:src="@drawable/ic_hamburger" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Mode"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_slide_manager"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Slides"
                android:textColor="#64B5F6"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Draggable & Resizable Circular Camera Overlay Container.

             Anchored to the top-start corner on purpose, never centred: the
             position is driven by setX()/setY(), which are translations from the
             laid-out slot. A centred slot moves whenever the parent is re-measured,
             which would drag the face cam with it. Pinned at (0,0) the translation
             IS the absolute position, so the cam holds still across every relayout. -->
        <FrameLayout
            android:id="@+id/camera_root_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/camera_card_container"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="120dp"
                app:cardElevation="12dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/camera_preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Last frame shown while the camera is being flipped -->
                <ImageView
                    android:id="@+id/iv_camera_freeze_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Resize Handle Icon (visible for 3s upon tap on camera circle) -->
            <ImageView
                android:id="@+id/btn_resize_handle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_rect_resize_handle"
                android:contentDescription="Resize Handle"
                android:elevation="16dp"
                android:padding="6dp"
                android:src="@drawable/ic_aspect_ratio"
                android:visibility="gone" />

            <!-- Flip camera icon (bottom-left 45 degrees, shown together with the resize handle) -->
            <ImageView
                android:id="@+id/btn_flip_camera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_rect_resize_handle"
                android:contentDescription="Flip Camera"
                android:elevation="16dp"
                android:padding="6dp"
                android:src="@drawable/ic_flip_camera"
                android:visibility="gone" />

        </FrameLayout>



        <!-- Bottom 20% Navigation Overlay -->
        <LinearLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:weightSum="10">

            <!-- PREVIOUS Zone: Left 20% -->
            <FrameLayout
                android:id="@+id/zone_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_nav"
                    android:clickable="false"
                    android:contentDescription="Previous Slide"
                    android:focusable="false"
                    android:src="@drawable/ic_chevron_left" />
            </FrameLayout>

            <!-- RECORD Zone: Center 60% -->
            <FrameLayout
                android:id="@+id/zone_record"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6">

                <Button
                    android:id="@+id/btn_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_btn_record_red"
                    android:backgroundTint="#E53935"
                    app:backgroundTint="#E53935"
                    android:elevation="6dp"
                    android:text="Start Record"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- NEXT Zone: Right 20% -->
            <FrameLayout
                android:id="@+id/zone_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_nav"
                    android:clickable="false"
                    android:contentDescription="Previous Slide"
                    android:focusable="false"
                    android:src="@drawable/ic_chevron_right" />
            </FrameLayout>

        </LinearLayout>

        <!-- Crop Guide Lines (visible during presentation preview/browsing and countdown, hidden during active recording) -->
        <View
            android:id="@+id/guide_line_9_16"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:elevation="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/guide_label_9_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:elevation="20dp"
            android:paddingEnd="8dp"
            android:text="9:16"
            android:textColor="#55FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <View
            android:id="@+id/guide_line_4_5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:elevation="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/guide_label_4_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:elevation="20dp"
            android:paddingEnd="8dp"
            android:text="4:5"
            android:textColor="#55FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <View
            android:id="@+id/guide_line_1_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:elevation="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/guide_label_1_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:elevation="20dp"
            android:paddingEnd="8dp"
            android:text="1:1"
            android:textColor="#55FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Minimal Low-Opacity Floating Stop Icon for Recording Mode -->
        <ImageButton
            android:id="@+id/btn_stop_record_floating"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="70dp"
            android:alpha="0.25"
            android:background="@drawable/bg_circle_stop_minimal"
            android:contentDescription="Stop Recording"
            android:elevation="12dp"
            android:padding="7dp"
            android:src="@drawable/ic_stop"
            android:visibility="gone" />

        <!-- Red Arrow Hint for First-Time Users (appOpenedTimes <= 2) -->
        <ImageView
            android:id="@+id/iv_stop_arrow_hint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="66dp"
            android:layout_marginEnd="4dp"
            android:layout_toLeftOf="@id/btn_stop_record_floating"
            android:contentDescription="Stop Button Arrow Hint"
            android:elevation="13dp"
            android:src="@drawable/ic_arrow_right_red"
            android:visibility="gone" />

        <!-- First-run swipe tutorial hint (non-clickable; positioned in code) -->
        <LinearLayout
            android:id="@+id/swipe_hint_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:elevation="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_swipe_hint_hand"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Swipe hint"
                android:src="@drawable/ic_swipe_hand" />

            <TextView
                android:id="@+id/tv_swipe_hint_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#99000000"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Countdown Overlay UI -->
        <FrameLayout
            android:id="@+id/countdown_overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
            android:elevation="25dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="#EF1F1F1F"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                app:strokeColor="#44FFFFFF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="RECORDING STARTS IN"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_countdown_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="3"
                        android:textColor="#FF5252"
                        android:textSize="64sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_cancel_countdown"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Fullscreen Start Flash Effect Overlay -->
        <View
            android:id="@+id/flash_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:elevation="30dp"
            android:visibility="gone"
            android:alpha="0" />

    </RelativeLayout>

    <!-- Left Navigation Drawer View -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FF181818"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>