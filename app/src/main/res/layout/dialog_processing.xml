<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_processing_screen"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp">

            <View
                android:id="@+id/processing_halo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_processing_icon_halo" />

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_processing_icon"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/processing_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ai_sparkle" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/processing_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Replacing facecam background using AI"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Please keep the app open"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/processing_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="36dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_processing" />

        <TextView
            android:id="@+id/processing_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0%"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
