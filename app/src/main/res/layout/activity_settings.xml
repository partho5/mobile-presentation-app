<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_left"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btn_back"
            android:text="@string/set_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/settings_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_autosave_hint"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <!-- Permissions still missing; rows are built at runtime, hidden when none are missing -->
            <LinearLayout
                android:id="@+id/permissions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/view_settings_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/set_permissions_header"
                    android:textColor="#FFB347"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/permissions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Content is set in SettingsActivity: only the permissions still missing -->
                <com.jovoc.facecampresentationrecorder.ui.SettingsHelpView
                    android:id="@+id/permissions_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Face cam over other apps: there is no switch (it follows you when you leave the app
                 while recording), so this row shows only while the plan lacks it, as the way to
                 the upgrade sheet (SettingsActivity.syncFloatingCam) -->
            <LinearLayout
                android:id="@+id/section_floating_cam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/view_settings_divider" />

                <LinearLayout
                    android:id="@+id/row_floating_cam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/feature_floating_cam_name"
                                android:textColor="#22D3EE"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_premium_floating_cam"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@string/premium_cd"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_tier_floating_cam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/feature_floating_cam_benefit"
                            android:textColor="#AAAAAA"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#888888" />
                </LinearLayout>
            </LinearLayout>

            <!-- Countdown -->
            <include layout="@layout/view_settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/set_countdown_header"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_countdown_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_countdown_off"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_countdown_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_countdown_3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_countdown_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_countdown_5"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_countdown_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_countdown_10"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>

            <com.jovoc.facecampresentationrecorder.ui.SettingsHelpView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:helpSection="countdown" />

            <!-- Audio -->
            <include layout="@layout/view_settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/set_audio_header"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_audio_mic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_audio_mic"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_audio_mute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_audio_mute"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Only shown while an external microphone is connected; filled in by SettingsActivity -->
            <LinearLayout
                android:id="@+id/audio_input_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/audio_src_header"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_audio_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.jovoc.facecampresentationrecorder.ui.SettingsHelpView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:helpSection="audio" />

            <!-- Auto-crop -->
            <include layout="@layout/view_settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/set_crop_header"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Each gated row: the toggle plus a tier badge (shown while locked, see SettingsActivity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_crop_9_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_crop_9_16"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_tier_crop_9_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_crop_4_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_crop_4_5"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_tier_crop_4_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_crop_1_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_crop_1_1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_tier_crop_1_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.jovoc.facecampresentationrecorder.ui.SettingsHelpView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:helpSection="auto_crop" />

            <!-- AI virtual background -->
            <include layout="@layout/view_settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/set_bg_header"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Always-visible tips for a clean background replacement -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_bg_tips_title"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/set_bg_tip_wall"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/set_bg_tip_light"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/set_bg_tip_gpu"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_bg_replace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#22D3EE"
                    android:minHeight="48dp"
                    android:text="@string/set_bg_replace"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_tier_bg_replace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/set_bg_pick"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <!-- Cards are built in SettingsActivity: assets/bg_samples/, the user's own photos, then an add card -->
            <GridLayout
                android:id="@+id/grid_bg_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />

            <com.jovoc.facecampresentationrecorder.ui.SettingsHelpView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:helpSection="background" />

            <!-- Captions & Subtitles (Part 4) -->
            <include layout="@layout/view_settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/set_subtitles_header"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_burn_subtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE"
                android:minHeight="48dp"
                android:text="@string/set_subtitles_burn_checkbox"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_burn_subtitles_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_subtitles_burn_hint"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_subtitles_template_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="@string/set_subtitles_template_header"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <!-- Subtitle Style Cards Carousel -->
            <HorizontalScrollView
                android:id="@+id/scroll_subtitle_templates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_subtitle_cards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Card 1: Default Green -->
                    <FrameLayout
                        android:id="@+id/card_sub_green"
                        android:layout_width="130dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_subtitle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_subtitle_pill_green"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="Subtitles"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/set_subtitles_template_green"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_check_sub_green"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#22D3EE"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Card 2: Vibrant Yellow -->
                    <FrameLayout
                        android:id="@+id/card_sub_yellow"
                        android:layout_width="130dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_subtitle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_subtitle_pill_yellow"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="Subtitles"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/set_subtitles_template_yellow"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_check_sub_yellow"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#22D3EE"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Card 3: Clean White -->
                    <FrameLayout
                        android:id="@+id/card_sub_white"
                        android:layout_width="130dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_subtitle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_subtitle_pill_white"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="Subtitles"
                                android:textColor="#00E5FF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/set_subtitles_template_white"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_check_sub_white"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#22D3EE"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Card 4: Pro Gradient / Bounce -->
                    <FrameLayout
                        android:id="@+id/card_sub_premium"
                        android:layout_width="130dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_subtitle_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_subtitle_pill_premium"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="Subtitles"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/set_subtitles_template_premium"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Top-start: Crown & Tier badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_crown_sub_premium"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@string/premium_cd"
                                android:src="@drawable/ic_premium" />

                            <TextView
                                android:id="@+id/tv_tier_sub_premium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_check_sub_premium"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#22D3EE"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Subtitle Live Preview Box -->
            <FrameLayout
                android:id="@+id/box_subtitle_preview"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_subtitle_preview_screen"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:text="PREVIEW"
                    android:textColor="#555E6D"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play"
                    app:tint="#555E6D" />

                <!-- Mockup video subtitle centered in preview -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Line 1: "Create " [ engaging ] " videos" -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_sub_prev_prefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1.5"
                            android:shadowDy="1.5"
                            android:shadowRadius="4"
                            android:text="Create "
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_sub_prev_highlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_subtitle_pill_green"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="engaging"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_sub_prev_suffix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1.5"
                            android:shadowDy="1.5"
                            android:shadowRadius="4"
                            android:text=" videos"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Line 2: "with AI subtitles" -->
                    <TextView
                        android:id="@+id/tv_sub_prev_line2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="4"
                        android:text="with AI subtitles"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Auto upload: one row into the Auto upload screen; the subtitle is set in SettingsActivity -->
            <include layout="@layout/view_settings_divider" />

            <LinearLayout
                android:id="@+id/row_auto_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_connect_publishing"
                        android:textColor="#22D3EE"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_auto_upload_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#888888" />
            </LinearLayout>

            <include layout="@layout/view_settings_divider" />

            <CheckBox
                android:id="@+id/cb_wifi_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE"
                android:minHeight="48dp"
                android:text="@string/set_wifi_only_checkbox"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_wifi_only_hint"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <include layout="@layout/view_settings_divider" />

            <CheckBox
                android:id="@+id/cb_show_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#22D3EE"
                android:minHeight="48dp"
                android:text="@string/set_show_editor_checkbox"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_show_editor_hint"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
