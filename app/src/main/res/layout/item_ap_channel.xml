<?xml version="1.0" encoding="utf-8"?>
<!-- A connected channel under its platform: avatar, name, and the auto-publish switch or a state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="44dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/iv_ap_channel_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_ap_icon_placeholder" />

    <TextView
        android:id="@+id/tv_ap_channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#DDDDDD"
        android:textSize="14sp"
        tools:text="My channel" />

    <TextView
        android:id="@+id/tv_ap_channel_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Manual posting only"
        tools:visibility="visible" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_ap_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:thumbTint="@color/ap_switch_thumb"
        app:trackTint="@color/ap_switch_track" />
</LinearLayout>
