<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/header_title_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_close_dialog"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_player_icon_badge"
                android:contentDescription="Video Player Icon"
                android:padding="7dp"
                android:src="@drawable/ic_video_library"
                app:tint="#22D3EE" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.01"
                    android:text="Video Player"
                    android:textColor="#F5F7FA"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dialog_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SAVED RECORDING"
                    android:textColor="#5C6B7A"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Player"
            android:src="@drawable/ic_close"
            app:tint="#6B7684" />
    </RelativeLayout>

    <!-- Accent rule under the header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_player_accent_rule" />

    <!-- Video Surface -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_card_container"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#1FFFFFFF"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/player_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Center Play/Pause Touch Overlay Button -->
            <ImageButton
                android:id="@+id/btn_center_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_nav"
                android:backgroundTint="#CC0B1015"
                android:contentDescription="Play or Pause Video"
                android:padding="14dp"
                android:src="@drawable/ic_play"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Transport Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_player_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <ImageButton
            android:id="@+id/btn_bar_play_pause"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause Bar Toggle"
            android:src="@drawable/ic_play"
            app:tint="#22D3EE" />

        <TextView
            android:id="@+id/tv_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:text="00:00"
            android:textColor="#E6EDF3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/player_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressBackgroundTint="#2A3038"
            android:progressTint="#06B6D4"
            android:thumbTint="#22D3EE" />

        <TextView
            android:id="@+id/tv_total_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="00:00"
            android:textColor="#6B7684"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- File Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_player_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Recording_2026.mp4"
                android:textColor="#F5F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_rename_video"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rename Video"
                android:src="@drawable/ic_edit"
                app:tint="#22D3EE" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_player_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Sep 23, 2026 • 14.2 MB"
            android:textColor="#6B7684"
            android:textSize="11sp"
            tools:text="Sep 23, 2026 • 14.2 MB • 9:16" />

        <TextView
            android:id="@+id/tv_crop_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="#8FA0B0"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_video"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            app:backgroundTint="#141720"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="17dp"
            app:iconTint="#FF6B6B"
            app:rippleColor="#33FF6B6B"
            app:strokeColor="#40FF6B6B"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_video"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="Share"
            android:textAllCaps="false"
            android:textColor="#04222A"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#22D3EE"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_share"
            app:iconSize="17dp"
            app:iconTint="#04222A"
            app:rippleColor="#33FFFFFF" />
    </LinearLayout>

</LinearLayout>
