<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_dialog"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/header_title_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_close_dialog"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_player_icon_badge"
                android:contentDescription="Video Player Icon"
                android:padding="7dp"
                android:src="@drawable/ic_video_library"
                app:tint="#22D3EE" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.01"
                    android:text="Video Preview"
                    android:textColor="#F5F7FA"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Player"
            android:src="@drawable/ic_close"
            app:tint="#6B7684" />
    </RelativeLayout>

    <!-- Accent rule under the header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_player_accent_rule" />

    <!-- Video Surface -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_card_container"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#1FFFFFFF"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/player_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Invisible tap area: tapping the video toggles play/pause, nothing is drawn -->
            <View
                android:id="@+id/btn_center_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Play or Pause Video"
                android:foreground="@null" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Transport Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_player_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <ImageButton
            android:id="@+id/btn_bar_play_pause"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause Bar Toggle"
            android:src="@drawable/ic_play"
            app:tint="#22D3EE" />

        <TextView
            android:id="@+id/tv_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:text="00:00"
            android:textColor="#E6EDF3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/player_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressBackgroundTint="#2A3038"
            android:progressTint="#06B6D4"
            android:thumbTint="#22D3EE" />

        <TextView
            android:id="@+id/tv_total_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="00:00"
            android:textColor="#6B7684"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- File details: name + info on the left, rename / delete / share on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_player_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="Recording_2026.mp4"
                    android:textColor="#F5F7FA"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Sep 23, 2026 • 14.2 MB"
                    android:textColor="#6B7684"
                    android:textSize="11sp"
                    tools:text="Sep 23, 2026 • 14.2 MB • 9:16" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_rename_video"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rename Video"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                app:tint="#22D3EE" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/crop_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_crop_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="⏳"
                android:textColor="#8FA0B0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_crop_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8FA0B0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Divider + icon-only actions on their own row at the bottom of the card -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-8dp"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_delete_video"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Video"
                android:padding="10dp"
                android:src="@drawable/ic_delete"
                app:tint="#FF6B6B" />

            <ImageButton
                android:id="@+id/btn_share_video"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share Video"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                app:tint="#22D3EE" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
