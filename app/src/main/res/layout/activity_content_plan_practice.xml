<?xml version="1.0" encoding="utf-8"?>
<!-- Practice screen of a content-plan day (ContentPlanPracticeActivity): no camera, no recording. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/practice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cplan_practice_title"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/practice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/practice_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_plan_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#64B5F6"
                android:textDirection="firstStrong"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/practice_why"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#B3FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="13sp" />

            <!-- The stage: the hook as it will look in the recording. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#000000"
                android:minHeight="200dp">

                <TextView
                    android:id="@+id/practice_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/bitter"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="24dp"
                    android:textColor="#FFFFFF"
                    android:textDirection="firstStrong"
                    android:textSize="26sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/practice_say_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cplan_you_say"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/practice_say"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/practice_prev"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cplan_previous"
                    android:textColor="#64B5F6" />

                <TextView
                    android:id="@+id/practice_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/practice_next"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cplan_next_beat"
                    android:textColor="#64B5F6" />
            </LinearLayout>

            <Button
                android:id="@+id/practice_toggle_script"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cplan_show_script"
                android:textColor="#64B5F6" />

            <LinearLayout
                android:id="@+id/practice_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/practice_use"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cplan_use_topics"
            android:textColor="#64B5F6" />

        <Button
            android:id="@+id/practice_done"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cplan_done"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>
</LinearLayout>
