<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded_cyan"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_website_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Website Slide"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter website URL to display"
        android:textColor="#B2DFDB"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edit_website_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_white_border_cyan"
        android:hint="google.com"
        android:textColorHint="#757575"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="#000000"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_website"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#B2DFDB" />

        <Button
            android:id="@+id/btn_save_website"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#80CBC4"
            android:text="Save"
            android:textColor="#00363A" />
    </LinearLayout>
</LinearLayout>
