<?xml version="1.0" encoding="utf-8"?>
<!-- Dark surface for the recording card's overflow menu, so it matches the
     hardcoded-dark screens regardless of the device's light/dark setting. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1B1F27" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
