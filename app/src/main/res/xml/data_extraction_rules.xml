<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens are bound to this device's Keystore; never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_secure.xml" />
        <exclude domain="sharedpref" path="MasterKey" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_secure.xml" />
    </device-transfer>
</data-extraction-rules>
