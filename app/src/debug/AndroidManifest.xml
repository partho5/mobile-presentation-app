<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test harness for after-recording background replacement.
     Launch: adb shell am start -n com.jovoc.facecampresentationrecorder/.bgreplace.BgTestActivity -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.jovoc.facecampresentationrecorder.bgreplace.BgTestActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <!-- Debug sheets (AI edit cards C4 and C9) are NOT installed. Their code stays in src/debug/java
             (aiedit/debugsheet). To use one again for debugging, uncomment its activity below.
             Then open it from the launcher (add the LAUNCHER intent-filter) or with
             adb shell am start -n com.jovoc.facecampresentationrecorder/.aiedit.debugsheet.MotionSheetActivity

        <activity
            android:name="com.jovoc.facecampresentationrecorder.aiedit.debugsheet.MotionSheetActivity"
            android:exported="true"
            android:label="Motion sheet"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.jovoc.facecampresentationrecorder.aiedit.debugsheet.LookSheetActivity"
            android:exported="true"
            android:label="Look sheet"
            android:screenOrientation="portrait" />
        -->

    </application>
</manifest>
